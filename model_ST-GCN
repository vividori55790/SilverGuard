import torch
import torch.nn as nn
import numpy as np

class Graph:
    def __init__(self, device='cpu'):
        self.num_node = 17
        self.edges = [
            (0,1), (0,2), (1,3), (2,4), (0,5), (0,6), (5,7), (7,9), 
            (6,8), (8,10), (5,11), (6,12), (11,13), (13,15), (12,14), (14,16)
        ]
        self.A = self.get_adjacency_matrix(device)

    def get_adjacency_matrix(self, device):
        A = np.zeros((self.num_node, self.num_node))
        for i, j in self.edges:
            A[i, j] = 1
            A[j, i] = 1
        for i in range(self.num_node):
            A[i, i] = 1
            
        row_sum = np.sum(A, axis=1)
        D_inv_sqrt = np.power(row_sum, -0.5)
        D_inv_sqrt[np.isinf(D_inv_sqrt)] = 0.
        D_mat_inv_sqrt = np.diag(D_inv_sqrt)
        norm_A = D_mat_inv_sqrt.dot(A).dot(D_mat_inv_sqrt)
        return torch.FloatTensor(norm_A).to(device)

class GraphConv(nn.Module):
    def __init__(self, in_channels, out_channels, A):
        super(GraphConv, self).__init__()
        self.fc = nn.Conv1d(in_channels, out_channels, kernel_size=1)
        self.register_buffer('A', A) # A를 모델 state에 포함
        self.bn = nn.BatchNorm1d(out_channels)
        self.relu = nn.ReLU()

    def forward(self, x):
        N, C, T, V = x.size()
        x = self.fc(x.view(N, C, T*V)).view(N, -1, T, V)
        x = torch.einsum('nctv,vw->nctw', (x, self.A))
        return self.relu(self.bn(x.view(N, -1, T*V)).view(N, -1, T, V))

class STGCN_Block(nn.Module):
    def __init__(self, in_channels, out_channels, A, stride=1):
        super(STGCN_Block, self).__init__()
        self.gcn = GraphConv(in_channels, out_channels, A)
        self.tcn = nn.Sequential(
            nn.BatchNorm2d(out_channels),
            nn.ReLU(),
            nn.Conv2d(out_channels, out_channels, (9, 1), padding=(4, 0), stride=(stride, 1)),
            nn.BatchNorm2d(out_channels),
            nn.Dropout(0.2)
        )
        self.residual = nn.Sequential()
        if in_channels != out_channels or stride != 1:
            self.residual = nn.Conv2d(in_channels, out_channels, (1, 1), stride=(stride, 1))

    def forward(self, x):
        return self.tcn(self.gcn(x)) + self.residual(x)

class LightSTGCN(nn.Module):
    def __init__(self, num_classes=2, in_channels=7, device='cpu'):
        super(LightSTGCN, self).__init__()
        self.graph = Graph(device)
        A = self.graph.A
        
        self.layer1 = STGCN_Block(in_channels, 32, A)
        self.layer2 = STGCN_Block(32, 64, A, stride=2)
        self.layer3 = STGCN_Block(64, 128, A, stride=2)
        self.fc = nn.Conv2d(128, num_classes, kernel_size=1)

    def forward(self, x):
        N, T, F = x.size()
        V = 17
        x = x.view(N, T, V, -1).permute(0, 3, 1, 2).contiguous()
        x = self.layer1(x)
        x = self.layer2(x)
        x = self.layer3(x)
        x = nn.functional.avg_pool2d(x, x.size()[2:])
        x = self.fc(x)
        return x.view(x.size(0), -1)